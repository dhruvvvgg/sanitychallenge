# No secrets here. Copy to .env.local (ignored). Default is deterministic local snapshot.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_KB_MCP_URL=
SANITY_DATA_MCP_URL=
SANITY_ORGANIZATION_TOKEN=
SANITY_ORGANIZATION_ID=
SANITY_CONTEXT_ENDPOINT_NAMES=
# Choose one provider; optional LLM_MODEL overrides the documented default.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
# Server-only project token is separate from the read-only Context Viewer token.
SANITY_WRITE_TOKEN=
# Set to /tmp/disruption-desk-gaps on Vercel for local diagnostic records only.
GAP_STORAGE_DIR=
