  {
    "_id": "rule-eu-arrival_delay",
    "_type": "rule",
    "title": "EU: long arrival delay",
    "regime": {
      "_type": "reference",
      "_ref": "regime-eu"
    },
    "trigger": "arrival_delay",
    "algorithm": "distance_compensation",
    "thresholds": {
      "reductionFraction": 0.5,
      "longBandValue": 600,
      "longReductionBelowMinutes": 240,
      "arrivalMinutes": 180
    },
    "conditions": [
      "confirmed reservation",
      "check-in deadline met unless cancellation",
      "single-flight scope",
      "publicly available fare or rewards ticket"
    ],
    "entitlements": [
      "compensation"
    ],
    "bands": [
      {
        "_type": "reference",
        "_ref": "band-eu-0",
        "_key": "k0"
